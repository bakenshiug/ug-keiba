      "trends": [
        {
          "label": "4・5歳の充実世代が中心",
          "value": "過去27年で4歳14勝・5歳10勝。6歳以降は計3勝のみと世代の壁が明確だ。働き盛りの4・5歳を主軸に据えるのが定石となる。",
          "weight": "extreme"
        },
        {
          "label": "差し優勢、渋れば前残り",
          "value": "脚質は差しが12勝で最多。ただし2025メイショウタバル・2022タイトルホルダーのように、流れを単騎で運べる逃げ・先行はそのまま粘り込む。馬場と展開の見極めが鍵だ。",
          "weight": "extreme"
        },
        {
          "label": "外の8枠が最多10勝",
          "value": "枠順は8枠が10勝と傑出。揉まれず外を回せた馬が浮上しやすい。内の1枠も複勝圏は多く、両極の傾向となる。",
          "weight": "high"
        },
        {
          "label": "1番人気は複勝率64%、だが伏兵も",
          "value": "1番人気は[8,8,2]で複勝率64%と信頼度が高い。一方で2025・2016・2010と7番人気以上の伏兵が制す年も定期的にある。",
          "weight": "high"
        },
        {
          "label": "阪神内回り2200mの消耗戦",
          "value": "小回りでの立ち回りと、上り坂を含む消耗戦への対応が問われる。スタミナと立ち回りの両立が必須となる。",
          "weight": "caution"
        }
      ],
      "trendsHaken": [
        {
          "label": "2着は5歳が台頭",
          "value": "2着には5歳馬が最多。地力上位が崩れても5歳が2着に粘るパターンが目立つ。",
